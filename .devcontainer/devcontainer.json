// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-existing-dockerfile
{
	"name": "pi",
	"dockerComposeFile": [
		"compose.extend.yml"
	],
	"service": "dev",
	//"remoteUser": "vscode",
	"customizations": {
		"vscode": {
			"extensions": [
				"yzhang.markdown-all-in-one",
                "ms-python.python",
                "ms-python.vscode-pylance",
                "h5web.vscode-h5web"
			]
		}
	},
	// workspace: no space between keys
	//"workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
	"workspaceFolder": "/workspace",
	// mount dataset folder if dataset is a symlink to a local folder
    "mounts": [
        "source=${localWorkspaceFolder},target=/workspace,type=bind",
		"source=${localWorkspaceFolder}/dataset/bot-pi/libero,target=/workspace/dataset/bot-pi/libero,type=bind"
    ],
	// add python path to the container
	"remoteEnv": {
		"PYTHONPATH": "/workspace/third_party/libero"
	}
}